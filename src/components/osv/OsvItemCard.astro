---
import {
  ACCENTS,
  FILE_TYPE_ICONS,
  ITEM_TYPE_ICONS,
  ITEM_TYPE_LABELS,
  STATUS_CLASSES,
  STATUS_LABELS,
  formatGrades,
  itemHref,
  searchIndex,
  sourceOrg,
  type OsvCategory,
  type OsvItem,
} from '../../lib/osv';

interface Props {
  item: OsvItem;
  category: OsvCategory;
  /** Na globálním hledání ukaž, do které kategorie položka patří. */
  showCategory?: boolean;
}

const { item, category, showCategory = false } = Astro.props;
const accent = ACCENTS[category.accent];
const gradeLabel = formatGrades(item.grades);
---
<article
  class={`osv-card flex flex-col bg-white rounded-xl shadow-sm ring-1 ring-gray-200 border-l-4 ${accent.border} p-5 transition-all duration-200 hover:shadow-md`}
  data-search={searchIndex(item)}
  data-type={item.type}
  data-status={item.status}
  data-category={item.categoryId}
  data-grades={(item.grades ?? []).join(',')}
>
  <div class="flex items-start gap-3">
    <span class="text-2xl leading-none shrink-0" aria-hidden="true">{ITEM_TYPE_ICONS[item.type]}</span>
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-gray-900 leading-snug">
        <a href={itemHref(item)} class="hover:text-primary-700 transition-colors">
          {item.title}
        </a>
      </h3>
      <div class="flex flex-wrap items-center gap-1.5 mt-2">
        <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${accent.chip}`}>
          {ITEM_TYPE_LABELS[item.type]}
        </span>
        <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${STATUS_CLASSES[item.status]}`}>
          {STATUS_LABELS[item.status]}
        </span>
        {showCategory && (
          <a
            href={`/osv/${category.id}`}
            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
          >
            <span aria-hidden="true">{category.icon}</span>
            <span>{category.shortName}</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <p class="mt-3 text-sm text-gray-600 leading-relaxed">{item.description}</p>

  {(item.duration || gradeLabel) && (
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
      {item.duration && <span>⏱️ {item.duration}</span>}
      {gradeLabel && <span>🎓 {gradeLabel}</span>}
    </div>
  )}

  {item.keywords.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {item.keywords.map((keyword) => (
        <li class="inline-flex items-center px-2 py-0.5 rounded bg-gray-50 border border-gray-200 text-xs text-gray-600">
          {keyword}
        </li>
      ))}
    </ul>
  )}

  <div class="mt-4 pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 text-sm">
    <div class="flex flex-wrap items-center gap-3 text-gray-500">
      {item.source && (
        <span class="inline-flex items-center gap-1" title={`Zdroj: ${item.source.label}`}>
          <span aria-hidden="true">📖</span>
          <span>{sourceOrg(item.source.label)}</span>
        </span>
      )}
      {item.files.length > 0 && (
        <span class="inline-flex items-center gap-1" title="Přiložené soubory">
          <span aria-hidden="true">{FILE_TYPE_ICONS[item.files[0].type] ?? '📎'}</span>
          <span>{item.files.length} {item.files.length === 1 ? 'soubor' : item.files.length < 5 ? 'soubory' : 'souborů'}</span>
        </span>
      )}
    </div>
    <div class="flex items-center gap-3">
      <a href={itemHref(item)} class="text-gray-500 hover:text-gray-800 hover:underline">Detail</a>
      {item.source?.url && (
        <a
          href={item.source.url}
          target="_blank"
          rel="noopener noreferrer"
          title={`Otevřít u zdroje: ${item.source.label}`}
          class={`inline-flex items-center gap-1 font-medium ${accent.text} hover:underline`}
        >
          Materiály ↗
        </a>
      )}
    </div>
  </div>
</article>
