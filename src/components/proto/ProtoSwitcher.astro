---
/**
 * Lišta prototypu: přepíná mezi návrhy na stejné podkapitole, aby šly
 * porovnat vedle sebe. Záměrně neutrální — není součástí žádného návrhu.
 */
interface Props {
  current: 0 | 1 | 2 | 3;
  topicId?: string;
  subtopicId?: string;
}
const { current, topicId, subtopicId } = Astro.props;
const sub = topicId && subtopicId;
const links = [
  { n: 1, label: 'Přípravna', href: sub ? `/test1/${topicId}/${subtopicId}` : '/test1' },
  { n: 2, label: 'Rejstřík', href: sub ? `/test2?s=${subtopicId}` : '/test2' },
  { n: 3, label: 'Kabinet', href: sub ? `/test3/${topicId}/${subtopicId}` : '/test3' },
];
---
<nav class="proto-switcher" aria-label="Přepínač návrhů">
  <a href="/test" class:list={['ps-home', current === 0 && 'is-current']}>Návrhy</a>
  <span class="ps-links">
    {links.map((l) => (
      <a href={l.href} class:list={[current === l.n && 'is-current']} aria-current={current === l.n ? 'page' : undefined}>
        <span class="ps-n">{l.n}</span><span class="ps-label">{l.label}</span>
      </a>
    ))}
  </span>
  <a href={sub ? `/${topicId}/${subtopicId}` : '/'} class="ps-live">Současný web</a>
</nav>

<style>
  .proto-switcher {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 36px;
    padding: 0 12px;
    padding-top: env(safe-area-inset-top);
    background: #1b1d1f;
    color: #c9cbce;
    font: 500 13px/1 system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .proto-switcher a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 8px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .proto-switcher a:hover { color: #fff; }
  .proto-switcher a:focus-visible { outline: 2px solid #fff; outline-offset: -2px; }
  .proto-switcher .is-current { color: #fff; border-bottom-color: #fff; }
  .ps-links { display: flex; }
  .ps-n {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #34373a;
    color: #fff;
    font-size: 12px;
  }
  .is-current .ps-n { background: #fff; color: #1b1d1f; }
  .ps-live { margin-left: auto; }
  @media (max-width: 520px) {
    .ps-label { display: none; }
  }
  @media print {
    .proto-switcher { display: none; }
  }
</style>
