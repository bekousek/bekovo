---
import {
  EQUIPMENT_LABELS,
  ITEM_TYPE_ICONS,
  ITEM_TYPE_LABELS,
  type Equipment,
  type InfoCategory,
  type InfoItem,
} from '../../lib/informatika';

interface Props {
  placeholder: string;
  items: InfoItem[];
  /** Oblasti — facet „Oblast“ se ukáže jen na rozcestníku. */
  categories?: InfoCategory[];
  /** Aktuální oblast — facet „Podoblast“ se ukáže jen na stránce oblasti. */
  category?: InfoCategory;
  /**
   * `inline` — karty jsou vidět rovnou a filtr je zužuje (stránka oblasti).
   * `reveal` — karty jsou schované, dokud uživatel nezačne hledat (rozcestník).
   */
  mode?: 'inline' | 'reveal';
}

const { placeholder, items, categories, category, mode = 'inline' } = Astro.props;

// Facet se ukáže jen tehdy, když v datech opravdu rozlišuje.
const present = <T,>(values: T[]) => new Set(values);

const presentCategories = present(items.map((i) => i.categoryId));
const categoryValues = (categories ?? [])
  .filter((c) => presentCategories.has(c.id))
  .map((c) => ({ value: c.id, label: `${c.icon} ${c.shortName}` }));

const presentSubs = present(items.map((i) => i.subcategoryId).filter(Boolean));
const subValues = (category?.subcategories ?? [])
  .filter((s) => presentSubs.has(s.id))
  .map((s) => ({ value: s.id, label: s.name }));

const presentTypes = present(items.map((i) => i.type));
const typeValues = (Object.keys(ITEM_TYPE_LABELS) as InfoItem['type'][])
  .filter((t) => presentTypes.has(t))
  .map((t) => ({ value: t, label: `${ITEM_TYPE_ICONS[t]} ${ITEM_TYPE_LABELS[t]}` }));

const presentEquipment = present(items.flatMap((i) => i.equipment ?? []));
const equipmentValues = (Object.keys(EQUIPMENT_LABELS) as Equipment[])
  .filter((e) => presentEquipment.has(e))
  .map((e) => ({ value: e, label: EQUIPMENT_LABELS[e] }));

const grades = [...present(items.flatMap((i) => i.grades ?? []))].sort((a, b) => a - b);
const gradeValues = grades.map((g) => ({ value: String(g), label: `${g}.` }));

const facets = [
  { key: 'category', label: 'Oblast', values: categoryValues },
  { key: 'sub', label: 'Podoblast', values: subValues },
  { key: 'type', label: 'Typ', values: typeValues },
  { key: 'equipment', label: 'Potřeba', values: equipmentValues },
  { key: 'grades', label: 'Ročník', values: gradeValues },
].filter((f) => f.values.length > 1);
---
<div data-inf-filter data-inf-mode={mode} class="mb-6">
  <label class="relative block">
    <span class="sr-only">Hledat</span>
    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400" aria-hidden="true">🔍</span>
    <input
      type="search"
      data-inf-query
      placeholder={placeholder}
      autocomplete="off"
      class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-300 bg-white text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
    />
  </label>

  {facets.length > 0 && (
    <div data-inf-facets hidden={mode === 'reveal'} class="mt-3 flex flex-col gap-2">
      {facets.map((facet) => (
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-medium text-gray-500 w-20 shrink-0">{facet.label}</span>
          {facet.values.map((option) => (
            <button
              type="button"
              data-inf-chip={facet.key}
              data-value={option.value}
              aria-pressed="false"
              class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border border-gray-200 bg-white text-gray-600 hover:border-primary-300 hover:text-primary-700 transition-colors aria-pressed:bg-primary-600 aria-pressed:text-white aria-pressed:border-primary-600"
            >
              {option.label}
            </button>
          ))}
        </div>
      ))}
    </div>
  )}

  <div class="mt-3 flex items-center justify-between gap-3 text-sm text-gray-500 min-h-6">
    <span class="flex items-center gap-3">
      {mode === 'reveal' && facets.length > 0 && (
        <button
          type="button"
          data-inf-toggle
          aria-expanded="false"
          class="inline-flex items-center gap-1 text-gray-600 hover:text-primary-700 font-medium"
        >
          <span aria-hidden="true">⚙️</span> Filtry
        </button>
      )}
      <span data-inf-count aria-live="polite"></span>
    </span>
    <button
      type="button"
      data-inf-reset
      hidden
      class="text-primary-600 hover:text-primary-800 hover:underline font-medium"
    >
      Zrušit filtry
    </button>
  </div>
</div>

<script>
  // Odpovídá `normalize()` v src/lib/osv.ts — index v `data-search` je
  // znormalizovaný už při buildu.
  const normalize = (text: string) =>
    text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const plural = (n: number, one: string, few: string, many: string) =>
    n === 1 ? one : n >= 2 && n <= 4 ? few : many;

  // Facety, jejichž `data-*` na kartě je seznam oddělený čárkou.
  const LIST_KEYS = new Set(['grades', 'equipment']);

  document.querySelectorAll<HTMLElement>('[data-inf-filter]').forEach((root) => {
    const scope = root.closest('[data-inf-scope]') ?? document;
    const input = root.querySelector<HTMLInputElement>('[data-inf-query]');
    const counter = root.querySelector<HTMLElement>('[data-inf-count]');
    const reset = root.querySelector<HTMLButtonElement>('[data-inf-reset]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-inf-chip]')];
    const cards = [...scope.querySelectorAll<HTMLElement>('.inf-card')];
    const groups = [...scope.querySelectorAll<HTMLElement>('[data-inf-group]')];
    const empty = scope.querySelector<HTMLElement>('[data-inf-empty]');
    const results = scope.querySelector<HTMLElement>('[data-inf-results]');
    const browse = scope.querySelector<HTMLElement>('[data-inf-browse]');
    const reveal = root.dataset.infMode === 'reveal';
    if (!input) return;

    const apply = () => {
      const words = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      const active = new Map<string, Set<string>>();
      for (const chip of chips) {
        if (chip.getAttribute('aria-pressed') !== 'true') continue;
        const key = chip.dataset.infChip!;
        if (!active.has(key)) active.set(key, new Set());
        active.get(key)!.add(chip.dataset.value!);
      }

      let visible = 0;
      for (const card of cards) {
        const haystack = card.dataset.search ?? '';
        let match = words.every((word) => haystack.includes(word));
        for (const [key, values] of active) {
          if (!match) break;
          const raw = card.dataset[key] ?? '';
          const own = LIST_KEYS.has(key) ? raw.split(',').filter(Boolean) : [raw];
          match = own.some((value) => values.has(value));
        }
        card.classList.toggle('hidden', !match);
        if (match) visible += 1;
      }

      // Podoblast bez jediné viditelné karty schovej i s nadpisem.
      for (const group of groups) {
        group.toggleAttribute('hidden', !group.querySelector('.inf-card:not(.hidden)'));
      }

      const filtering = words.length > 0 || active.size > 0;
      if (reveal) {
        results?.toggleAttribute('hidden', !filtering);
        browse?.toggleAttribute('hidden', filtering);
      }
      empty?.toggleAttribute('hidden', !(filtering && visible === 0));
      reset?.toggleAttribute('hidden', !filtering);
      if (counter) {
        counter.textContent = filtering
          ? `${visible} ${plural(visible, 'výsledek', 'výsledky', 'výsledků')} z ${cards.length}`
          : reveal
            ? ''
            : `${cards.length} ${plural(cards.length, 'položka', 'položky', 'položek')}`;
      }
    };

    // Rozcestník: facety jsou schované pod tlačítkem „Filtry“, ať nepřekáží oblastem.
    const toggle = root.querySelector<HTMLButtonElement>('[data-inf-toggle]');
    const facetBox = root.querySelector<HTMLElement>('[data-inf-facets]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      facetBox?.toggleAttribute('hidden', !open);
    });

    input.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    reset?.addEventListener('click', () => {
      input.value = '';
      for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
      apply();
      input.focus();
    });

    // „/“ skočí do hledání, Esc ho vyprázdní.
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const typing = target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
      if (event.key === '/' && !typing) {
        event.preventDefault();
        input.focus();
      } else if (event.key === 'Escape' && target === input) {
        input.value = '';
        apply();
      }
    });

    apply();
  });
</script>
