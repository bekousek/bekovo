---
import {
  ACCENTS,
  EQUIPMENT_LABELS,
  ITEM_TYPE_ICONS,
  ITEM_TYPE_LABELS,
  LANGUAGE_LABELS,
  categoryHref,
  formatGrades,
  hasDetail,
  hostname,
  primaryHref,
  searchIndex,
  subcategoryName,
  type InfoCategory,
  type InfoItem,
} from '../../lib/informatika';

interface Props {
  item: InfoItem;
  category: InfoCategory;
  /** Na globálním hledání ukaž, do které oblasti položka patří. */
  showCategory?: boolean;
}

const { item, category, showCategory = false } = Astro.props;
const accent = ACCENTS[category.accent];
const link = primaryHref(item);
const detail = hasDetail(item);
const host = hostname(item.url);
const sub = subcategoryName(category, item.subcategoryId);
const gradeLabel = formatGrades(item.grades);
const facts = [
  item.duration ? `⏱️ ${item.duration}` : null,
  gradeLabel ? `🎓 ${gradeLabel}` : null,
  ...(item.equipment ?? []).map((e) => EQUIPMENT_LABELS[e]),
  item.language && item.language !== 'cs' ? `🌍 ${LANGUAGE_LABELS[item.language]}` : null,
].filter(Boolean);
---
<article
  class={`inf-card flex flex-col bg-white rounded-xl shadow-sm ring-1 ring-gray-200 border-l-4 ${accent.border} p-4 transition-all duration-200 hover:shadow-md`}
  data-search={searchIndex(item, category)}
  data-type={item.type}
  data-category={item.categoryId}
  data-sub={item.subcategoryId ?? ''}
  data-equipment={(item.equipment ?? []).join(',')}
  data-grades={(item.grades ?? []).join(',')}
>
  <div class="flex items-start gap-3">
    <span class="text-xl leading-none shrink-0 mt-0.5" aria-hidden="true" title={ITEM_TYPE_LABELS[item.type]}>
      {ITEM_TYPE_ICONS[item.type]}
    </span>
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-gray-900 leading-snug">
        {link ? (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="hover:text-primary-700 transition-colors"
          >
            {item.title}{link.external && <span class="text-gray-400 font-normal" aria-hidden="true"> ↗</span>}
          </a>
        ) : item.title}
      </h3>
      <div class="flex flex-wrap items-center gap-1.5 mt-1.5 text-xs">
        <span class={`inline-flex items-center px-2 py-0.5 rounded-full font-medium ${accent.chip}`}>
          {ITEM_TYPE_LABELS[item.type]}
        </span>
        {showCategory && (
          <a
            href={categoryHref(category)}
            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
          >
            <span aria-hidden="true">{category.icon}</span>
            <span>{sub ? `${category.shortName} › ${sub}` : category.shortName}</span>
          </a>
        )}
        {host && <span class="text-gray-400 truncate">{host}</span>}
      </div>
    </div>
  </div>

  {item.description && <p class="mt-2.5 text-sm text-gray-600 leading-relaxed">{item.description}</p>}

  {facts.length > 0 && (
    <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
      {facts.map((fact) => <span>{fact}</span>)}
    </div>
  )}

  {detail && item.url && (
    <div class="mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-end gap-3 text-sm">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`font-medium ${accent.text} hover:underline`}
      >
        Otevřít ↗
      </a>
    </div>
  )}
</article>
