---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import {
  ACCENTS,
  BASE,
  EQUIPMENT_LABELS,
  FILE_TYPE_ICONS,
  ITEM_TYPE_ICONS,
  ITEM_TYPE_LABELS,
  LANGUAGE_LABELS,
  categoryHref,
  formatDate,
  formatGrades,
  getCategories,
  getItems,
  getSeriesById,
  getSeriesItems,
  hasDetail,
  hostname,
  primaryHref,
  seriesHref,
  subcategoryName,
  type InfoItem,
} from '../../../lib/informatika';

export async function getStaticPaths() {
  const categories = await getCategories();
  const items = await getItems();
  const byId = new Map(categories.map((c) => [c.id, c]));

  // Detail vzniká jen u položek, které mají co ukázat navíc oproti kartě.
  // Položka s neznámou oblastí se tiše přeskočí, ať zbytek webu jde nasadit.
  return items.flatMap((item) => {
    const category = byId.get(item.categoryId);
    if (!category || !hasDetail(item)) return [];
    return [{ params: { category: category.id, item: item.id }, props: { item, category } }];
  });
}

const { item, category } = Astro.props;
const accent = ACCENTS[category.accent];
const sub = subcategoryName(category, item.subcategoryId);
const gradeLabel = formatGrades(item.grades);

// Karta ze série: pořadí v sérii a sousední karty pro listování.
const series = item.series ? await getSeriesById(item.series.id) : undefined;
const seriesItems = series ? await getSeriesItems(series.id) : [];
const seriesIndex = seriesItems.findIndex((i) => i.id === item.id);
const neighbour = (other?: InfoItem) => {
  const link = other ? primaryHref(other) : null;
  return other && link ? { title: other.title, ...link } : null;
};
const prev = neighbour(seriesItems[seriesIndex - 1]);
const next = neighbour(seriesItems[seriesIndex + 1]);
const paragraphs = item.procedure?.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean) ?? [];

const meta = [
  { label: 'Typ', value: `${ITEM_TYPE_ICONS[item.type]} ${ITEM_TYPE_LABELS[item.type]}` },
  item.duration ? { label: 'Čas', value: `⏱️ ${item.duration}` } : null,
  gradeLabel ? { label: 'Ročník', value: `🎓 ${gradeLabel}` } : null,
  item.equipment?.length ? { label: 'Potřeba', value: item.equipment.map((e) => EQUIPMENT_LABELS[e]).join(', ') } : null,
  item.language ? { label: 'Jazyk', value: LANGUAGE_LABELS[item.language] } : null,
  item.added ? { label: 'Přidáno', value: formatDate(item.added)! } : null,
].filter((entry): entry is { label: string; value: string } => entry !== null);
---
<BaseLayout title={`${item.title} — Informatika`} description={item.description ?? category.tagline}>
  <Breadcrumb
    rootLabel="Informatika"
    rootHref={BASE}
    items={[{ label: category.name, href: categoryHref(category) }, { label: item.title }]}
  />

  <article class="max-w-3xl">
    <header class={`bg-white rounded-xl shadow-sm ring-1 ring-gray-200 border-l-4 ${accent.border} p-6`}>
      <div class="flex items-start gap-3">
        <span class="text-3xl shrink-0" aria-hidden="true">{ITEM_TYPE_ICONS[item.type]}</span>
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-bold text-gray-900 leading-tight">{item.title}</h1>
          <a
            href={categoryHref(category)}
            class={`mt-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${accent.chip} hover:underline`}
          >
            <span aria-hidden="true">{category.icon}</span>
            <span>{sub ? `${category.name} › ${sub}` : category.name}</span>
          </a>
        </div>
      </div>

      {item.description && <p class="mt-4 text-gray-700 leading-relaxed">{item.description}</p>}

      {item.url && (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white font-medium ${accent.bg} hover:opacity-90 transition-opacity`}
        >
          Otevřít {hostname(item.url)} <span aria-hidden="true">↗</span>
        </a>
      )}

      <dl class="mt-4 pt-4 border-t border-gray-100 grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
        {meta.map((entry) => (
          <div>
            <dt class="text-xs text-gray-500">{entry.label}</dt>
            <dd class="font-medium text-gray-800">{entry.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {series && (
      <nav
        class="mt-4 rounded-xl border border-gray-200 bg-white px-5 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm"
        aria-label={`Série ${series.name}`}
      >
        <a href={seriesHref(series)} class="font-medium text-gray-900 hover:text-primary-700">
          <span aria-hidden="true">{series.icon}</span> Série {series.name}
          <span class="font-normal text-gray-500">· {seriesIndex + 1} z {seriesItems.length}</span>
        </a>
        <span class="flex-1"></span>
        {prev && (
          <a
            href={prev.href}
            target={prev.external ? '_blank' : undefined}
            rel={prev.external ? 'noopener noreferrer' : undefined}
            class="text-gray-600 hover:text-primary-700"
            title={prev.title}
          >
            ← předchozí
          </a>
        )}
        {next && (
          <a
            href={next.href}
            target={next.external ? '_blank' : undefined}
            rel={next.external ? 'noopener noreferrer' : undefined}
            class="text-gray-600 hover:text-primary-700"
            title={next.title}
          >
            další →
          </a>
        )}
      </nav>
    )}

    {item.goal && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">🎯 Cíl</h2>
        <p class="mt-2 text-gray-700 leading-relaxed">{item.goal}</p>
      </section>
    )}

    {item.materials && item.materials.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">🧰 Pomůcky</h2>
        <ul class="mt-2 list-disc list-inside space-y-1 text-gray-700">
          {item.materials.map((material) => <li>{material}</li>)}
        </ul>
      </section>
    )}

    {paragraphs.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">🧭 Postup</h2>
        <div class="mt-2 space-y-3 text-gray-700 leading-relaxed">
          {paragraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
        </div>
      </section>
    )}

    {item.files.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">📎 Soubory</h2>
        <ul class="mt-2 space-y-2">
          {item.files.map((file) => (
            <li>
              <a
                href={file.href}
                target={file.href.startsWith('/') ? undefined : '_blank'}
                rel={file.href.startsWith('/') ? undefined : 'noopener noreferrer'}
                class="flex items-start gap-2 rounded-lg border border-gray-200 p-3 hover:border-primary-300 hover:bg-primary-50 transition-colors"
              >
                <span class="text-xl shrink-0" aria-hidden="true">{FILE_TYPE_ICONS[file.type] ?? '📎'}</span>
                <span class="min-w-0">
                  <span class="block font-medium text-gray-900">{file.label}</span>
                  {file.note && <span class="block text-sm text-gray-500">{file.note}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {item.notes && (
      <section class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-5">
        <h2 class="font-semibold text-amber-900">📝 Moje poznámka</h2>
        <p class="mt-2 text-amber-900/90 leading-relaxed whitespace-pre-line">{item.notes}</p>
      </section>
    )}

    {(item.source || item.keywords.length > 0) && (
      <footer class="mt-4 rounded-xl border border-gray-200 bg-white p-5 space-y-4">
        {item.source && (
          <div>
            <h2 class="font-semibold text-gray-900">📖 Zdroj</h2>
            {item.source.url ? (
              <a
                href={item.source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-flex items-center gap-1 text-primary-600 hover:text-primary-800 hover:underline break-all"
              >
                <span>{item.source.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <p class="mt-1 text-gray-700">{item.source.label}</p>
            )}
          </div>
        )}
        {item.keywords.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {item.keywords.map((keyword) => (
              <li class="inline-flex items-center px-2 py-0.5 rounded bg-gray-50 border border-gray-200 text-xs text-gray-600">
                {keyword}
              </li>
            ))}
          </ul>
        )}
      </footer>
    )}
  </article>
</BaseLayout>
