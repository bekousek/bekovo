---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import InfoItemCard from '../../../components/informatika/InfoItemCard.astro';
import {
  BASE,
  FILE_TYPE_ICONS,
  getCategories,
  getSeries,
  getSeriesItems,
  hostname,
  plural,
  primaryHref,
  type InfoItem,
} from '../../../lib/informatika';

export async function getStaticPaths() {
  const series = await getSeries();
  return series.map((s) => ({ params: { series: s.id }, props: { series: s } }));
}

const { series } = Astro.props;
const categories = await getCategories();
const byId = new Map(categories.map((c) => [c.id, c]));
const items = await getSeriesItems(series.id);
const paragraphs = series.description?.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean) ?? [];

// Ke kterým kartám video patří — podle shody odkazu v `files` karet série.
const usedIn = new Map<string, InfoItem[]>();
for (const item of items) {
  for (const file of item.files) {
    if (file.type !== 'video') continue;
    usedIn.set(file.href, [...(usedIn.get(file.href) ?? []), item]);
  }
}
// Název karty bez opakovaného „<série>: “ na začátku.
const prefix = `${series.name}: `;
const shortTitle = (item: InfoItem) => (item.title.startsWith(prefix) ? item.title.slice(prefix.length) : item.title);
const videoCount = series.videoGroups.reduce((sum, group) => sum + group.videos.length, 0);
---
<BaseLayout title={`${series.name} — Informatika`} description={series.tagline}>
  <Breadcrumb rootLabel="Informatika" rootHref={BASE} items={[{ label: series.name }]} />

  <header class="max-w-3xl bg-white rounded-xl shadow-sm ring-1 ring-gray-200 border-l-4 border-l-gray-800 p-6">
    <div class="flex items-start gap-3">
      <span class="text-4xl shrink-0 leading-none" aria-hidden="true">{series.icon}</span>
      <div class="flex-1 min-w-0">
        <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Série</p>
        <h1 class="text-2xl font-bold text-gray-900 leading-tight">{series.name}</h1>
        <p class="mt-1 text-gray-600">{series.tagline}</p>
      </div>
    </div>

    {paragraphs.length > 0 && (
      <div class="mt-4 space-y-3 text-gray-700 leading-relaxed">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    )}

    <div class="mt-4 flex flex-wrap items-center gap-3">
      {series.url && (
        <a
          href={series.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white font-medium bg-gray-800 hover:opacity-90 transition-opacity"
        >
          Otevřít {hostname(series.url)} <span aria-hidden="true">↗</span>
        </a>
      )}
      <span class="text-sm text-gray-500">
        {items.length} {plural(items.length, 'karta', 'karty', 'karet')}
        {videoCount > 0 && ` · ${videoCount} ${plural(videoCount, 'video', 'videa', 'videí')}`}
      </span>
    </div>
  </header>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Lekce a aktivity</h2>
    <p class="mt-1 text-sm text-gray-600">Každá karta žije ve své oblasti — tady jsou pohromadě v doporučeném pořadí.</p>
    <ol class="mt-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 items-start">
      {items.flatMap((item, index) => {
        const category = byId.get(item.categoryId);
        if (!category) return [];
        return [
          <li class="relative pl-3">
            <span
              class="absolute left-0 top-3 -translate-x-1/2 z-10 flex h-6 w-6 items-center justify-center rounded-full bg-gray-800 text-xs font-semibold text-white shadow"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <InfoItemCard item={item} category={category} showCategory hideSeries />
          </li>,
        ];
      })}
    </ol>
  </section>

  {series.videoGroups.length > 0 && (
    <section class="mt-10 max-w-4xl">
      <h2 class="text-lg font-semibold text-gray-900">Průvodce videi</h2>
      <p class="mt-1 text-sm text-gray-600">Všechna videa seriálu a lekce, ke které patří — ať ji pouští, nebo ji doplňuje.</p>
      {series.videoGroups.map((group) => (
        <div class="mt-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{group.name}</h3>
          <ul class="mt-2 divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white">
            {group.videos.map((video) => {
              const lessons = usedIn.get(video.href) ?? [];
              return (
                <li class="p-3 sm:flex sm:items-start sm:gap-4">
                  <div class="flex-1 min-w-0">
                    <a
                      href={video.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-gray-900 hover:text-primary-700"
                    >
                      🎬 {video.title}<span class="text-gray-400 font-normal" aria-hidden="true"> ↗</span>
                    </a>
                    {video.duration && <span class="ml-1 text-xs text-gray-500">{video.duration}</span>}
                    {video.about && <p class="mt-0.5 text-sm text-gray-600">{video.about}</p>}
                  </div>
                  {lessons.length > 0 && (
                    <div class="mt-2 sm:mt-0 sm:w-64 shrink-0 flex flex-wrap gap-1.5 sm:justify-end">
                      {lessons.map((lesson) => {
                        const link = primaryHref(lesson);
                        const number = items.indexOf(lesson) + 1;
                        return link ? (
                          <a
                            href={link.href}
                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
                          >
                            <span class="text-gray-500">{number}.</span> {shortTitle(lesson)}
                          </a>
                        ) : null;
                      })}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  )}

  {series.files.length > 0 && (
    <section class="mt-10 max-w-3xl rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="font-semibold text-gray-900">📎 Pro učitele ke všem lekcím</h2>
      <ul class="mt-2 space-y-2">
        {series.files.map((file) => (
          <li>
            <a
              href={file.href}
              target={file.href.startsWith('/') ? undefined : '_blank'}
              rel={file.href.startsWith('/') ? undefined : 'noopener noreferrer'}
              class="flex items-start gap-2 rounded-lg border border-gray-200 p-3 hover:border-primary-300 hover:bg-primary-50 transition-colors"
            >
              <span class="text-xl shrink-0" aria-hidden="true">{FILE_TYPE_ICONS[file.type] ?? '📎'}</span>
              <span class="min-w-0">
                <span class="block font-medium text-gray-900">{file.label}</span>
                {file.note && <span class="block text-sm text-gray-500">{file.note}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {series.source && (
    <p class="mt-6 max-w-3xl text-sm text-gray-500">
      Zdroj:{' '}
      {series.source.url ? (
        <a href={series.source.url} target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline">
          {series.source.label} ↗
        </a>
      ) : series.source.label}
    </p>
  )}
</BaseLayout>
