---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import {
  ACCENTS,
  FILE_TYPE_ICONS,
  ITEM_TYPE_ICONS,
  ITEM_TYPE_LABELS,
  STATUS_CLASSES,
  STATUS_LABELS,
  formatDate,
  formatGrades,
  getCategories,
  getItems,
} from '../../../lib/osv';

export async function getStaticPaths() {
  const categories = await getCategories();
  const items = await getItems();
  const byId = new Map(categories.map((c) => [c.id, c]));

  return items.flatMap((item) => {
    const category = byId.get(item.categoryId);
    // Položka s neznámou kategorií by shodila build na `category.name`;
    // radši ji tiše přeskoč, ať zbytek webu jde nasadit.
    if (!category) return [];
    return [{
      params: { category: category.id, item: item.id },
      props: { item, category },
    }];
  });
}

const { item, category } = Astro.props;
const accent = ACCENTS[category.accent];
const gradeLabel = formatGrades(item.grades);
const paragraphs = item.procedure?.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean) ?? [];

const meta = [
  { label: 'Typ', value: `${ITEM_TYPE_ICONS[item.type]} ${ITEM_TYPE_LABELS[item.type]}` },
  item.duration ? { label: 'Čas', value: `⏱️ ${item.duration}` } : null,
  gradeLabel ? { label: 'Ročník', value: `🎓 ${gradeLabel}` } : null,
  item.added ? { label: 'Přidáno', value: formatDate(item.added)! } : null,
].filter((entry): entry is { label: string; value: string } => entry !== null);
---
<BaseLayout title={`${item.title} — OSV`} description={item.description}>
  <Breadcrumb
    rootLabel="OSV"
    rootHref="/osv"
    items={[
      { label: category.name, href: `/osv/${category.id}` },
      { label: item.title },
    ]}
  />

  <article class="max-w-3xl">
    <header class={`bg-white rounded-xl shadow-sm ring-1 ring-gray-200 border-l-4 ${accent.border} p-6`}>
      <div class="flex items-start gap-3">
        <span class="text-3xl shrink-0" aria-hidden="true">{ITEM_TYPE_ICONS[item.type]}</span>
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-bold text-gray-900 leading-tight">{item.title}</h1>
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            <a
              href={`/osv/${category.id}`}
              class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${accent.chip} hover:underline`}
            >
              <span aria-hidden="true">{category.icon}</span>
              <span>{category.name}</span>
            </a>
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${STATUS_CLASSES[item.status]}`}>
              {STATUS_LABELS[item.status]}
            </span>
          </div>
        </div>
      </div>

      <p class="mt-4 text-gray-700 leading-relaxed">{item.description}</p>

      <dl class="mt-4 pt-4 border-t border-gray-100 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
        {meta.map((entry) => (
          <div>
            <dt class="text-xs text-gray-500">{entry.label}</dt>
            <dd class="font-medium text-gray-800">{entry.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {item.goal && (
      <section class={`mt-4 rounded-xl border border-gray-200 bg-white p-5`}>
        <h2 class="font-semibold text-gray-900">🎯 Cíl</h2>
        <p class="mt-2 text-gray-700 leading-relaxed">{item.goal}</p>
      </section>
    )}

    {item.materials && item.materials.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">🧰 Pomůcky</h2>
        <ul class="mt-2 list-disc list-inside space-y-1 text-gray-700">
          {item.materials.map((material) => <li>{material}</li>)}
        </ul>
      </section>
    )}

    {paragraphs.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">🧭 Postup</h2>
        <div class="mt-2 space-y-3 text-gray-700 leading-relaxed">
          {paragraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
        </div>
      </section>
    )}

    {item.reflection && item.reflection.length > 0 && (
      <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900">💬 Otázky do reflexe</h2>
        <ul class="mt-2 list-disc list-inside space-y-1 text-gray-700">
          {item.reflection.map((question) => <li>{question}</li>)}
        </ul>
      </section>
    )}

    <section class="mt-4 rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="font-semibold text-gray-900">📎 Přiložené soubory</h2>
      {item.files.length > 0 ? (
        <ul class="mt-2 space-y-2">
          {item.files.map((file) => (
            <li>
              <a
                href={file.href}
                target={file.href.startsWith('/') ? undefined : '_blank'}
                rel={file.href.startsWith('/') ? undefined : 'noopener noreferrer'}
                class="flex items-start gap-2 rounded-lg border border-gray-200 p-3 hover:border-primary-300 hover:bg-primary-50 transition-colors"
              >
                <span class="text-xl shrink-0" aria-hidden="true">{FILE_TYPE_ICONS[file.type] ?? '📎'}</span>
                <span class="min-w-0">
                  <span class="block font-medium text-gray-900">{file.label}</span>
                  {file.note && <span class="block text-sm text-gray-500">{file.note}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2 text-sm text-gray-500">
          Zatím nic. Soubory patří do <code class="px-1 py-0.5 rounded bg-gray-100 text-gray-700">public/osv-soubory/</code>
          nebo na Google Drive — pak stačí doplnit pole <code class="px-1 py-0.5 rounded bg-gray-100 text-gray-700">files</code>.
        </p>
      )}
    </section>

    {item.notes && (
      <section class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-5">
        <h2 class="font-semibold text-amber-900">📝 Moje poznámka</h2>
        <p class="mt-2 text-amber-900/90 leading-relaxed whitespace-pre-line">{item.notes}</p>
      </section>
    )}

    <footer class="mt-4 rounded-xl border border-gray-200 bg-white p-5 space-y-4">
      {item.source && (
        <div>
          <h2 class="font-semibold text-gray-900">📖 Původní zdroj</h2>
          {item.source.url ? (
            <a
              href={item.source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex items-center gap-1 text-primary-600 hover:text-primary-800 hover:underline break-all"
            >
              <span>{item.source.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <p class="mt-1 text-gray-700">{item.source.label}</p>
          )}
          {item.source.note && <p class="mt-1 text-sm text-gray-500">{item.source.note}</p>}
        </div>
      )}

      {item.keywords.length > 0 && (
        <div>
          <h2 class="text-sm font-medium text-gray-700">Klíčová slova</h2>
          <ul class="mt-1.5 flex flex-wrap gap-1.5">
            {item.keywords.map((keyword) => (
              <li class="inline-flex items-center px-2 py-0.5 rounded bg-gray-50 border border-gray-200 text-xs text-gray-600">
                {keyword}
              </li>
            ))}
          </ul>
        </div>
      )}

      {item.rvpAreas && item.rvpAreas.length > 0 && (
        <div>
          <h2 class="text-sm font-medium text-gray-700">Podoblasti RVP</h2>
          <ul class="mt-1.5 flex flex-wrap gap-1.5">
            {item.rvpAreas.map((area) => (
              <li class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${accent.chip}`}>
                {area}
              </li>
            ))}
          </ul>
        </div>
      )}
    </footer>

    <a href={`/osv/${category.id}`} class="mt-6 inline-flex items-center gap-1 text-sm text-primary-600 hover:text-primary-800 hover:underline">
      ← Zpět na {category.name}
    </a>
  </article>
</BaseLayout>
