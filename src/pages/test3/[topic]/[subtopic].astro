---
/**
 * Návrh 3 — Kabinet: podkapitola jako poličky kartiček podle druhu (telefon:
 * vodorovně palcem, PC: mřížka). Karta se otevře jako recept (pomůcky + postup)
 * a pokus/aktivita jde spustit v režimu „V hodině" — velké písmo, krok za krokem,
 * obrazovka nezhasne.
 */
import ProtoLayout from '../../../layouts/ProtoLayout.astro';
import ProtoMark from '../../../components/proto/ProtoMark.astro';
import Icon from '../../../components/proto/Icon.astro';
import { getLibrary, getProtoSubtopicPaths, sectionLinks, type LibraryItem } from '../../../lib/library/data';
import { AUDIENCE_LABEL, KINDS, KIND_LABEL, MATERIAL_ACTION, countKind, plural } from '../../../lib/library/model';
import { fileLinkLabel } from '../../../lib/fileLink';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../../../styles/proto-kabinet.css';

export const getStaticPaths = getProtoSubtopicPaths;

const { topicId, subtopicId } = Astro.props;
const lib = await getLibrary();
const topic = lib.topicById.get(topicId)!;
const sub = lib.subById.get(subtopicId)!;
const items = lib.bySub.get(subtopicId) ?? [];

const of = (kind: string, types?: string[]) =>
  items.filter((i) => i.kind === kind && (!types || types.includes(i.type)));
const shelves = [
  { id: 'pokusy', label: 'Pokusy', k: 'pokus', list: of('pokus') },
  { id: 'applety', label: 'Applety', k: 'material', list: of('material', ['applet']) },
  { id: 'videa', label: 'Videa', k: 'material', list: of('material', ['video']) },
  { id: 'aktivity', label: 'Aktivity', k: 'aktivita', list: of('aktivita') },
  { id: 'listy', label: 'Pracovní listy a odkazy', k: 'material', list: of('material', ['worksheet', 'link', 'other']) },
  { id: 'ukoly', label: 'Domácí úkoly', k: 'ukol', list: of('ukol') },
].filter((s) => s.list.length);

const exps = of('pokus');
const hasZak = exps.some((i) => i.audience === 'zak' || i.audience === 'oboje');
const hasDemo = exps.some((i) => i.audience === 'demo' || i.audience === 'oboje');

const live = (i: LibraryItem) => (i.kind === 'pokus' || i.kind === 'aktivita') && (i.steps.length > 1 || i.materials.length > 0);

const tagOf = (i: LibraryItem) =>
  i.kind === 'pokus'
    ? `${i.audience ? AUDIENCE_LABEL[i.audience] : 'Pokus'}${i.type === 'measurement' ? ' · s měřením' : ''}`
    : i.kind === 'ukol'
      ? 'Domácí úkol'
      : i.typeLabel;

const footOf = (i: LibraryItem) => {
  if (i.kind === 'pokus') {
    const parts = [];
    if (i.materials.length) parts.push(`${i.materials.length} ${plural(i.materials.length, 'pomůcka', 'pomůcky', 'pomůcek')}`);
    if (i.steps.length) parts.push(`${i.steps.length} ${plural(i.steps.length, 'krok', 'kroky', 'kroků')}`);
    return parts.join(' · ');
  }
  if (i.kind === 'material') return i.host ?? '';
  return i.source?.label ?? '';
};

const liveData = Object.fromEntries(
  items.filter(live).map((i) => [
    i.key,
    { t: i.title, k: i.kind, s: i.steps, m: i.materials, o: i.optional.flatMap((o, n) => (o ? [n] : [])) },
  ]),
);
---
<ProtoLayout title={`${sub.name} · Kabinet`} concept="kabinet" current={3} topicId={topic.id} subtopicId={sub.id} themeColor="#f3f5f7">
  <div class="kb-wrap">
    <div class="kb-bar">
      <a class="kb-brand" href="/test3"><ProtoMark size={22} /> Kabinet</a>
      <span class="kb-crumb">/ <a href={`/test3#g${topic.grade}`}>{topic.name}</a> · {topic.grade}. třída</span>
    </div>

    <header class="kb-head">
      <h1 class="kb-h1">{sub.name}</h1>
      <p class="kb-sum">
        {KINDS.filter((k) => sub.counts[k]).map((k) => (
          <span class="kb-count" data-k={k}>{countKind(k, sub.counts[k])}</span>
        ))}
      </p>
      <ul class="kb-sec" aria-label="Další k podkapitole">
        {sectionLinks(sub).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </header>

    {shelves.map((s) => (
      <section class="kb-shelf" data-shelf={s.id} aria-labelledby={`sh-${s.id}`}>
        <div class="kb-shelf-head">
          <h2 id={`sh-${s.id}`}>{s.label} <span class="num">{s.list.length}</span></h2>
          {s.id === 'pokusy' && hasZak && hasDemo && (
            <div class="kb-seg" role="group" aria-label="Kdo pokus provádí">
              <button type="button" data-aud="all" aria-pressed="true">Všechny</button>
              <button type="button" data-aud="zak" aria-pressed="false">Žákovské</button>
              <button type="button" data-aud="demo" aria-pressed="false">Demonstrační</button>
            </div>
          )}
          {s.list.length > 2 && (
            <button type="button" class="kb-more" data-expand aria-expanded="false" data-total={s.list.length}>
              Zobrazit všech {s.list.length}
            </button>
          )}
        </div>
        <ul class="kb-row">
          {s.list.map((i) => (
            <li class="kb-card" data-k={i.kind} data-key={i.key} data-aud={i.audience ?? 'none'}>
              <a class="kb-card-hit" href={`#${i.key}`} data-recipe-open={i.key}>
                <span class="kb-tag">{tagOf(i)}</span>
                <h3>{i.title}</h3>
                <p class="kb-card-ex">{i.excerpt}</p>
              </a>
              <div class="kb-card-foot">
                <span class="grow">{footOf(i)}</span>
                {i.url && (
                  <a class="kb-launch" href={i.url} target="_blank" rel="noopener noreferrer" aria-label={`${MATERIAL_ACTION[i.type] ?? 'Otevřít'}: ${i.title}`}>
                    Spustit <Icon name="external" size={16} />
                  </a>
                )}
                {live(i) && (
                  <button type="button" class="kb-live-btn" data-live={i.key} aria-label={`V hodině: ${i.title}`}>
                    <Icon name="play" size={16} /> V hodině
                  </button>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {items.length === 0 && (
      <div class="kb-empty">
        V téhle podkapitole zatím nejsou pokusy, aktivity, materiály ani úkoly. Zkus <a href="/test3">jinou podkapitolu</a>.
      </div>
    )}
  </div>

  <div hidden data-recipes>
    {items.map((i) => (
      <article class="kb-rec" data-rec={i.key} hidden>
        <div class="kb-rec-tags">
          <span class="kb-tag" data-k={i.kind}>{KIND_LABEL[i.kind].one}</span>
          <span class="kb-tag" data-k={i.kind}>{tagOf(i)}</span>
          {i.host && <span class="kb-tag" data-k={i.kind}>{i.host}</span>}
        </div>
        <h2>{i.title}</h2>
        {(i.url || live(i)) && (
          <div class="kb-rec-actions">
            {live(i) && <button type="button" class="kb-btn" data-live={i.key}><Icon name="play" /> Režim V hodině</button>}
            {i.url && <a class="kb-btn" href={i.url} target="_blank" rel="noopener noreferrer">{MATERIAL_ACTION[i.type] ?? 'Otevřít'} <Icon name="external" /></a>}
          </div>
        )}
        {i.materials.length > 0 && (
          <section>
            <h3>Pomůcky</h3>
            <ul class="kb-ingr">
              {i.materials.map((m, n) => (
                <li><label><input type="checkbox" /><span>{m}{i.optional[n] && !/volitel/i.test(m) && <small> (volitelně)</small>}</span></label></li>
              ))}
            </ul>
          </section>
        )}
        {i.kind === 'pokus' && i.steps.length > 0 && (
          <section>
            <h3>Postup</h3>
            <ol class="kb-steps">{i.steps.map((s) => <li><span>{s}</span></li>)}</ol>
          </section>
        )}
        <section class="kb-rec-desc">
          {i.kind === 'pokus' && <h3>O pokusu</h3>}
          {i.paragraphs.map((p) => <p>{p}</p>)}
        </section>
        {i.links.length > 0 && (
          <section>
            <h3>Odkazy</h3>
            <ul class="kb-ingr">{i.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}</ul>
          </section>
        )}
        {(i.source || i.driveFileUrl) && (
          <footer class="kb-rec-foot">
            {i.driveFileUrl && <a href={i.driveFileUrl} target="_blank" rel="noopener noreferrer">{fileLinkLabel(i.driveFileUrl)}</a>}
            {i.source && (i.source.url
              ? <span>Zdroj: <a href={i.source.url} target="_blank" rel="noopener noreferrer">{i.source.label} ↗</a></span>
              : <span>Zdroj: {i.source.label}</span>)}
          </footer>
        )}
      </article>
    ))}
  </div>

  <dialog class="kb-recipe" id="kb-recipe" aria-label="Karta položky">
    <div class="kb-recipe-bar">
      <button type="button" class="kb-iconbtn" data-close aria-label="Zavřít kartu"><Icon name="close" size={22} /></button>
      <strong data-rec-title style="font-size: 16px;"></strong>
    </div>
    <div class="kb-recipe-body" data-rec-body></div>
  </dialog>

  <dialog class="kb-live" id="kb-live" aria-label="Režim V hodině" data-size="0">
    <div class="kb-live-inner">
      <div class="kb-live-top">
        <button type="button" class="kb-iconbtn" data-close aria-label="Ukončit režim V hodině"><Icon name="close" size={24} /></button>
        <span class="title" data-live-title></span>
        <span class="kb-wake" data-wake></span>
        <button type="button" class="kb-iconbtn" data-size-toggle aria-label="Velikost písma" title="Velikost písma" style="font-weight:700;">Aa</button>
      </div>
      <div class="kb-live-stage" data-stage aria-live="polite"></div>
      <div class="kb-live-nav">
        <button type="button" data-prev><Icon name="prev" size={22} /> Zpět</button>
        <div>
          <div class="kb-live-progress" data-progress></div>
          <div class="kb-live-dots" data-dots></div>
        </div>
        <button type="button" data-next>Další <Icon name="next" size={22} /></button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="kb-live-data" set:html={JSON.stringify(liveData)} />
</ProtoLayout>

<script>
  import { openDialog, storeGet, storeSet } from '../../../lib/library/browser';

  type Live = { t: string; k: string; s: string[]; m: string[]; o: number[] };
  const liveData: Record<string, Live> = JSON.parse(document.getElementById('kb-live-data')!.textContent ?? '{}');

  // --- Poličky: rozbalit / sbalit, filtr žákovské × demonstrační ------------

  document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((shelf) => {
    const more = shelf.querySelector<HTMLButtonElement>('[data-expand]');
    more?.addEventListener('click', () => {
      const open = shelf.classList.toggle('is-open');
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? 'Sbalit' : `Zobrazit všech ${more.dataset.total}`;
      if (!open) shelf.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
    const segs = [...shelf.querySelectorAll<HTMLButtonElement>('[data-aud]')];
    for (const seg of segs) {
      seg.addEventListener('click', () => {
        const want = seg.dataset.aud!;
        segs.forEach((s) => s.setAttribute('aria-pressed', String(s === seg)));
        // Filtrovaná polička se rozbalí, aby na PC nezůstaly díry po skrytých kartách.
        if (want !== 'all' && !shelf.classList.contains('is-open')) more?.click();
        shelf.querySelectorAll<HTMLElement>('.kb-card').forEach((card) => {
          const aud = card.dataset.aud;
          card.hidden = !(want === 'all' || aud === want || aud === 'oboje');
        });
        shelf.querySelector('.kb-row')!.scrollLeft = 0;
      });
    }
  });

  // --- Karta jako recept -----------------------------------------------------

  const recipe = document.getElementById('kb-recipe') as HTMLDialogElement;
  const recBody = recipe.querySelector<HTMLElement>('[data-rec-body]')!;
  const store = document.querySelector<HTMLElement>('[data-recipes]')!;

  const openRecipe = (key: string) => {
    const rec = document.querySelector<HTMLElement>(`[data-rec="${CSS.escape(key)}"]`);
    if (!rec) return;
    if (recBody.firstElementChild) store.append(recBody.firstElementChild);
    rec.hidden = false;
    recBody.replaceChildren(rec);
    recipe.querySelector('[data-rec-title]')!.textContent = rec.querySelector('.kb-tag')?.textContent ?? '';
    openDialog(recipe);
    recipe.scrollTop = 0;
    recBody.scrollTop = 0;
  };
  recipe.querySelector('[data-close]')!.addEventListener('click', () => recipe.close());
  recipe.addEventListener('click', (e) => {
    if (e.target === recipe) recipe.close(); // klik na pozadí (PC)
  });
  recipe.addEventListener('close', () => {
    const rec = recBody.firstElementChild as HTMLElement | null;
    if (rec) {
      rec.hidden = true;
      store.append(rec);
    }
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-recipe-open]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      openRecipe(a.dataset.recipeOpen!);
    }),
  );

  // --- Režim V hodině --------------------------------------------------------

  const liveEl = document.getElementById('kb-live') as HTMLDialogElement;
  const stage = liveEl.querySelector<HTMLElement>('[data-stage]')!;
  const progress = liveEl.querySelector<HTMLElement>('[data-progress]')!;
  const dots = liveEl.querySelector<HTMLElement>('[data-dots]')!;
  const prevBtn = liveEl.querySelector<HTMLButtonElement>('[data-prev]')!;
  const nextBtn = liveEl.querySelector<HTMLButtonElement>('[data-next]')!;
  const wakeEl = liveEl.querySelector<HTMLElement>('[data-wake]')!;
  const SIZE_KEY = 'bekovo-proto-live-size';
  liveEl.dataset.size = storeGet(SIZE_KEY) ?? '0';

  type Screen = { kind: 'ingr' } | { kind: 'step'; text: string; n: number; of: number } | { kind: 'done' };
  let screens: Screen[] = [];
  let at = 0;
  let current: Live | null = null;
  const ticked = new Set<number>();

  const renderLive = () => {
    const s = screens[at];
    stage.replaceChildren();
    if (s.kind === 'ingr') {
      const label = document.createElement('p');
      label.className = 'kb-live-label';
      label.textContent = 'Nachystej pomůcky';
      const ul = document.createElement('ul');
      ul.className = 'kb-live-ingr';
      current!.m.forEach((m, i) => {
        const li = document.createElement('li');
        li.innerHTML = '<label><input type="checkbox"><span></span></label>';
        li.querySelector('span')!.textContent = current!.o.includes(i) && !/volitel/i.test(m) ? `${m} (volitelně)` : m;
        const box = li.querySelector('input')!;
        box.checked = ticked.has(i);
        box.addEventListener('change', () => (box.checked ? ticked.add(i) : ticked.delete(i)));
        ul.append(li);
      });
      stage.append(label, ul);
    } else if (s.kind === 'step') {
      const label = document.createElement('p');
      label.className = 'kb-live-label';
      label.textContent = `Krok ${s.n} z ${s.of}`;
      const text = document.createElement('p');
      text.className = 'kb-live-text';
      text.textContent = s.text;
      stage.append(label, text);
    } else {
      const text = document.createElement('p');
      text.className = 'kb-live-text';
      text.textContent = 'Hotovo.';
      const label = document.createElement('p');
      label.className = 'kb-live-label';
      label.style.marginTop = '16px';
      label.textContent = 'Zavři křížkem, nebo se vrať k předchozímu kroku.';
      stage.append(text, label);
    }
    stage.scrollTop = 0;
    progress.textContent = `${at + 1} / ${screens.length}`;
    dots.replaceChildren(
      ...screens.map((_, i) => {
        const dot = document.createElement('i');
        if (i === at) dot.setAttribute('data-on', '');
        return dot;
      }),
    );
    prevBtn.disabled = at === 0;
    nextBtn.disabled = at === screens.length - 1;
  };
  const go = (delta: number) => {
    at = Math.min(Math.max(at + delta, 0), screens.length - 1);
    renderLive();
  };

  // Obrazovka nezhasne (Screen Wake Lock API; jen přes HTTPS).
  let lock: WakeLockSentinel | null = null;
  const setWake = (on: boolean | null) => {
    wakeEl.toggleAttribute('data-on', on === true);
    wakeEl.textContent = on === true ? 'Displej nezhasne' : on === null ? 'Displej může zhasnout' : '';
  };
  const requestLock = async () => {
    if (!('wakeLock' in navigator)) return setWake(null);
    try {
      lock = await navigator.wakeLock.request('screen');
      setWake(true);
      lock.addEventListener('release', () => setWake(liveEl.open ? null : false));
    } catch {
      setWake(null);
    }
  };
  document.addEventListener('visibilitychange', () => {
    if (liveEl.open && document.visibilityState === 'visible') requestLock();
  });

  const openLive = (key: string) => {
    current = liveData[key];
    if (!current) return;
    ticked.clear();
    const steps = current.s.length ? current.s : [];
    screens = [
      ...(current.m.length ? [{ kind: 'ingr' } as Screen] : []),
      ...steps.map((text, i) => ({ kind: 'step', text, n: i + 1, of: steps.length }) as Screen),
      { kind: 'done' } as Screen,
    ];
    at = 0;
    liveEl.querySelector('[data-live-title]')!.textContent = current.t;
    if (recipe.open) recipe.close();
    openDialog(liveEl);
    renderLive();
    requestLock();
    nextBtn.focus();
  };
  liveEl.addEventListener('close', () => {
    lock?.release();
    lock = null;
    setWake(false);
  });
  liveEl.querySelector('[data-close]')!.addEventListener('click', () => liveEl.close());
  liveEl.querySelector('[data-size-toggle]')!.addEventListener('click', () => {
    liveEl.dataset.size = String((Number(liveEl.dataset.size) + 1) % 3);
    storeSet(SIZE_KEY, liveEl.dataset.size);
  });
  prevBtn.addEventListener('click', () => go(-1));
  nextBtn.addEventListener('click', () => go(1));
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-live]');
    if (btn) openLive(btn.dataset.live!);
  });
  liveEl.addEventListener('keydown', (e) => {
    if (['ArrowRight', 'PageDown', ' '].includes(e.key) && !(e.target as HTMLElement).matches('input')) {
      e.preventDefault();
      go(1);
    } else if (['ArrowLeft', 'PageUp'].includes(e.key)) {
      e.preventDefault();
      go(-1);
    }
  });
  // Tah prstem doleva / doprava.
  let startX = 0;
  let startY = 0;
  stage.addEventListener('pointerdown', (e) => {
    startX = e.clientX;
    startY = e.clientY;
  });
  stage.addEventListener('pointerup', (e) => {
    const dx = e.clientX - startX;
    if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(e.clientY - startY) * 1.5) go(dx < 0 ? 1 : -1);
  });

  // Přímý odkaz na kartu (#e.id).
  const fromHash = decodeURIComponent(location.hash.slice(1));
  if (fromHash) {
    history.replaceState(null, '', location.pathname + location.search);
    openRecipe(fromHash);
  }
</script>
